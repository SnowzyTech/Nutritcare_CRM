{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/doc-sync-check.ps1"
            ],
            "timeout": 20,
            "statusMessage": "Checking docs are in sync with code changes..."
          }
        ]
      }
    ]
  }
}
